# K9 Training Vision System - 环境变量模板
# 复制为 .env 并填入真实值；.env 不入 Git。
#
# !!! SECURITY / 必读 !!!
# 本仓库曾为 PUBLIC GitHub，历史版本 config.py 含硬编码默认口令与 JWT secret。
# 那些值已视为泄露：即使本模板只含占位符，你也必须：
#   1) 轮换 PostgreSQL 密码（不要再用历史默认口令）
#   2) 轮换 Label Studio 密码（若曾使用）
#   3) 生成全新 AUTH_SECRET_KEY（≥32 字符）并吊销旧 JWT
# 详见仓库 README「安全」一节。

# === 数据库（必须替换 CHANGE_ME_STRONG_PASSWORD） ===
DATABASE_URL=postgresql+asyncpg://k9system:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5433/k9system
PG_DSN=postgresql://k9system:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5433/k9system

# === JWT（APP_ENV=production 时必填；≥32 字符唯一随机串） ===
# 生成示例: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=CHANGE_ME_GENERATE_UNIQUE_32CHAR_PLUS_SECRET

# === Label Studio（管线已废弃，仅占位；若历史用过请轮换） ===
LS_URL=http://127.0.0.1:8080
LS_EMAIL=admin@k9.local
LS_PASSWORD=CHANGE_ME

# === Redis / Celery ===
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# === 应用（端口与 config.app_port 一致：8000） ===
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# === 行为识别部署模式（可选，P0-4） ===
# 不设置时按 APP_ENV 推断：production → rule_only（识别未过线前保守默认值）；
# development/test → shadow（影子对比）。显式设置可覆盖：
# shadow / vote / primary_stgcn / mamba_* / rule_only（取值见 backend/app/core/config.py）
# BEHAVIOR_DEPLOY_MODE=rule_only

# === CORS ===
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000"]
